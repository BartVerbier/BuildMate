# Build Pilot backend — environment template.
#
#   cp .env.example .env      # then fill in real values
#
# .env is gitignored; this template (placeholders only) is committed.
# Loaded at startup by buildpilot/__main__.py (load_env_file). Existing shell
# environment variables always win. See SECRETS.md for the full explanation.
#
# ── Secrets ──────────────────────────────────────────────────────────────────

# Shared bearer token protecting every endpoint except /health. Must match the
# iPhone app's BUILDMATE_API_TOKEN (iphone/BuildPilot/Secrets.xcconfig) and the
# Railway variable of the same name. LEAVE UNSET for pure-local development —
# the backend then runs with authentication disabled. Used by: buildpilot/auth.py
BUILDPILOT_API_TOKEN=

# Anthropic API key for requirements extraction (the one paid AI call/visit).
# Unset → extraction degrades to the default paint scope. Used by:
# buildpilot/pipelines/extraction.py
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Visualization ("proposed result" render). Choose ONE path:
#  (a) Gemini Developer API — simplest: set this key alone.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#  (b) Vertex AI — set the project + a service-account key file instead (below).
#      If GOOGLE_CLOUD_PROJECT is set it takes precedence over GEMINI_API_KEY.

# Vertex AI service account (path is resolved relative to backend/ if not
# absolute). The file it points at (vertex-key.json) is itself a secret and is
# gitignored. On Railway use GOOGLE_APPLICATION_CREDENTIALS_JSON instead (paste
# the JSON content). Used by: buildpilot/pipelines/visualization.py, __main__.py
GOOGLE_APPLICATION_CREDENTIALS=vertex-key.json

# ── Non-secret configuration (safe to commit real values; here for reference) ─
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# BUILDPILOT_SESSIONS_DIR=./sessions
# BUILDPILOT_TRANSCRIBER=            # mlx | faster-whisper (auto by platform)
# BUILDPILOT_EXTRACTOR_MODEL=claude-opus-4-8
# BUILDPILOT_WHISPER_MODEL=mlx-community/whisper-base-mlx
# BUILDPILOT_VISUALIZER_MODEL=       # override the image model
