# macOS
.DS_Store

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Local secrets — real values only; templates (*.example) stay tracked
.env
.env.*
!.env.example
vertex-key.json
*service-account*.json
# iOS build secrets (API token, contractor id) — use Secrets.example.xcconfig
Secrets.xcconfig

# Xcode (the .xcodeproj is generated by XcodeGen from project.yml)
DerivedData/
xcuserdata/
*.xcuserstate
*.xcodeproj/

# Runtime session data
backend/sessions/
