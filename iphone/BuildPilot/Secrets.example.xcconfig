// Template for build secrets. Copy to Secrets.xcconfig (gitignored) and fill in.
//
//   cp Secrets.example.xcconfig Secrets.xcconfig
//
// BUILDMATE_API_TOKEN must match the backend's BUILDPILOT_API_TOKEN. Leave it
// empty for pure-local development (the Mac backend runs with auth disabled).
// BUILDMATE_CONTRACTOR_ID identifies which contractor owns projects from this
// device; "default" is correct for single-tenant V1.
BUILDMATE_CONTRACTOR_ID = default
BUILDMATE_API_TOKEN =
